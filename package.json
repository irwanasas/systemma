{
  "name": "systemma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:reset": "supabase db reset && PGOPTIONS='-c aurora.seed=local' psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -q -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:start": "supabase start -x gotrue,realtime,imgproxy,studio,postgres-meta,logflare,vector,supavisor,edge-runtime,mailpit",
    "db:demo": "npm run db:reset && PGOPTIONS='-c aurora.seed=local' psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -q -1 -v ON_ERROR_STOP=1 -f supabase/demo/demo-seed.sql && node --env-file=.env.local supabase/demo/upload-proofs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
